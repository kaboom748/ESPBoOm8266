  void transportLost() {transportResetNeeded=true;}
};
static RecoveryState recovery;

static bool radioHomeVerified() {
  const auto &c=WebSdrCapture::status();
  if(c.busy||c.rxSessionActive||c.restoreFailures||c.retuneRestoreFailures||
     c.rxGateRestoreFailures||c.rxSessionRestoreFailures)return false;
  // Prior to the first radio loan, the application has changed no RF state.
  // A configured, associated SDK HOME context is still required by callers
  // that emit a RECOVERING reply or attempt a PM0 transmission.
  const bool neverBorrowed=!c.borrowCount&&!c.rxSessionLoans&&!c.retuneCount;
  return c.rfRestoreVerified&&(neverBorrowed||
    (c.rxSessionRestored&&(c.radioRestored||c.homeReturnVerified)));
