     c.borrowCount!=beforeBorrowCount||c.rxSessionLoans!=beforeSessionLoans||
     c.retuneCount!=beforeRetuneCount||c.rxGateCount!=beforeGateCount||
     WebSdrCapture::lastResult().sequence!=beforeCaptureSequence)return false;
  if(!WifiContextSnapshot::sameConnection(before,
      WifiContextSnapshot::read(bssid,boot,associations,disconnects,gotIp)))return false;
  if(WebSdrCapture::count()&&!WebSdrCapture::verifyBufferHash()) {
    latchedFault=true;captureValid=false;return false;
