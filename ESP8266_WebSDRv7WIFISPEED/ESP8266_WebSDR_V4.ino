  // A RECOVERING reply carries no IQ payload. Any retained valid IQ buffer
  // must nevertheless remain intact before the firmware advertises safety.
  const bool intact=!WebSdrCapture::count()||WebSdrCapture::verifyBufferHash();
  if(!intact){latchedFault=true;captureValid=false;}
